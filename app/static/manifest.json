{
  "name": "ZeroNode",
  "short_name": "ZeroNode",
  "description": "Zero-Knowledge Encrypted Personal Cloud Storage",
  "id": "/",
  "start_url": "/app/drive",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#000000",
  "theme_color": "#0e0e0e",
  "orientation": "any",
  "categories": ["productivity", "utilities", "security"],
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Files & Drive",
      "short_name": "Drive",
      "description": "Access encrypted files and folders",
      "url": "/app/drive",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Backups",
      "short_name": "Backup",
      "description": "Cloud backup and restore management",
      "url": "/app/backup",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Administration",
      "short_name": "Admin",
      "description": "Server administration and storage health",
      "url": "/app/admin",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]

# ZeroNode — Environment Configuration
# Copy this file to .env and fill in values. Never commit .env to version control.

# --- APPLICATION METADATA & VERSIONING ---
APP_NAME=ZeroNode
APP_VERSION=1.2.0
BUILD_ID=20261114.pwa

SECRET_KEY=change-this-to-a-random-string

# --- SSO CONFIGURATION ---
SSO_CLIENT_ID=9a609782720f5ec64b82888cb3c07b4d
SSO_CLIENT_SECRET=3c93458fdd9a1017c47fa9caae22364e
SSO_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
SSO_SCOPE=basic

# --- ADMINISTRATIVE CONFIGURATION ---
# The email of the root administrator. This user will be automatically 
# whitelisted and promoted to Admin status upon system initialization.
ADMIN_EMAIL=root@dkydivyansh.com

# --- OFFSITE BACKUP SERVER CONFIGURATION ---
# Dedicated endpoint and API key for automated offsite backup and restore
BACKUP_SERVER_URL=http://127.0.0.1:8080
BACKUP_SERVER_API_KEY=zeronode_secret_backup_key_2026
BACKUP_RETENTION=4
SERVER_BACKUP_ENABLED=1
SERVER_BACKUP_INTERVAL=daily
